{
  "name": "dotdo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:do": "vitest run --coverage --config do/vitest.config.ts",
    "test:coverage:db": "vitest run --coverage --config db/vitest.config.ts",
    "test:coverage:mcp": "vitest run --coverage --config mcp/vitest.config.ts",
    "test:coverage:api": "vitest run --coverage --config api/vitest.config.ts",
    "test:apps:todo-app": "cd apps/todo-app && npx vitest run",
    "test:apps:realtime-chat": "cd apps/realtime-chat && npx vitest run",
    "test:apps:dashboard": "cd apps/dashboard && npx vitest run tests/dashboard.test.ts",
    "test:apps:auth-api": "cd apps/auth-api && npx vitest run",
    "test:coverage:all": "npm run test:coverage && npm run test:coverage:do && npm run test:coverage:db && npm run test:coverage:mcp && npm run test:coverage:api",
    "test:do": "vitest --config do/vitest.config.ts",
    "test:db": "vitest --config db/vitest.config.ts",
    "test:mcp": "vitest --config mcp/vitest.config.ts",
    "test:api": "vitest --config api/vitest.config.ts",
    "test:all": "npm run test:run && npm run test:do -- run && npm run test:db -- run && npm run test:mcp -- run && npm run test:api -- run",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "lint:boundaries": "eslint --rule 'no-restricted-imports: error' .",
    "lint:fix": "eslint . --fix",
    "benchmark": "vitest run --config tests/benchmarks/vitest.config.ts",
    "benchmark:compare": "npx tsx tests/benchmarks/cli.ts compare",
    "benchmark:update": "npx tsx tests/benchmarks/cli.ts update",
    "benchmark:report": "npx tsx tests/benchmarks/cli.ts report",
    "submodule:init": "./scripts/submodule-init.sh",
    "submodule:update": "./scripts/submodule-update.sh",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "release:notes": "conventional-changelog -p angular -r 2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "commander": "^14.0.2",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.31.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "hono": "^4.11.4",
    "jose": "^6.1.3",
    "ora": "^9.1.0",
    "pako": "^2.1.0"
  }
}
