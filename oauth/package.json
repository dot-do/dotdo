{
  "name": "@dotdo/oauth",
  "version": "0.0.1",
  "description": "OAuth 2.1 + PKCE core for dotdo",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./pkce": {
      "import": "./src/core/pkce.ts",
      "types": "./src/core/pkce.ts"
    },
    "./state": {
      "import": "./src/core/state.ts",
      "types": "./src/core/state.ts"
    },
    "./storage": {
      "import": "./src/storage/index.ts",
      "types": "./src/storage/index.ts"
    },
    "./providers": {
      "import": "./src/providers/index.ts",
      "types": "./src/providers/index.ts"
    },
    "./middleware": {
      "import": "./src/middleware/index.ts",
      "types": "./src/middleware/index.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
