{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workflow-event-choreography-example",
  "main": "index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Four Durable Objects for choreography
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER",
        "class_name": "OrderDO"
      },
      {
        "name": "PAYMENT",
        "class_name": "PaymentDO"
      },
      {
        "name": "INVENTORY",
        "class_name": "InventoryDO"
      },
      {
        "name": "SHIPPING",
        "class_name": "ShippingDO"
      }
    ]
  },

  // Migrations for DOs with SQLite storage
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrderDO", "PaymentDO", "InventoryDO", "ShippingDO"]
    }
  ],

  // Development settings
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
