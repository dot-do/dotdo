{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-billing-cycle-example",
  "main": "index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        "name": "BILLING",
        "class_name": "BillingDO"
      }
    ]
  },

  // Migrations for DO with SQLite storage
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BillingDO"]
    }
  ],

  // Development settings
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
