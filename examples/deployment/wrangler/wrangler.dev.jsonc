{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dotdo-dev",
  "main": "worker.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],

  // Development settings
  "workers_dev": true,

  // Durable Object bindings
  "durable_objects": {
    "bindings": [
      { "name": "DO", "class_name": "DO" }
    ]
  },

  // Migrations
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DO"]
    }
  ],

  // Development environment variables
  "vars": {
    "ENVIRONMENT": "development",
    "LOG_LEVEL": "debug"
  },

  // Local development server settings
  "dev": {
    "port": 8787,
    "local_protocol": "http",
    "ip": "localhost"
  },

  // Optional: Use local persistence for development
  // This keeps data between restarts during local development
  // "persist_to": ".wrangler/state"

  // R2 buckets - can use same buckets as staging for dev
  // Or create local buckets for isolated testing
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "dotdo-backups-dev"
    },
    {
      "binding": "STORAGE",
      "bucket_name": "dotdo-storage-dev"
    }
  ],

  // KV namespace for development
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "your-dev-kv-namespace-id-here"
    }
  ]
}
