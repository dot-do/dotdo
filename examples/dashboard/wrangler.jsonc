{
  "name": "dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Object bindings
  "durable_objects": {
    "bindings": [
      {
        "name": "DASHBOARD_DO",
        "class_name": "DashboardDO"
      }
    ]
  },

  // Migrations for Durable Object classes
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DashboardDO"]
    }
  ]
}
