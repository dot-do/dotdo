{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {},
    "types": ["node"],
    "moduleResolution": "node",
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true
  },
  "include": ["*.ts", "cli/**/*.ts", "transport/**/*.ts", "auth/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "tests/**", "vitest.config.ts", "vitest.e2e.config.ts", "tsup.config.ts", "test-entry.ts"]
}
