{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types"]
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", ".worktrees", "primitives", "gitx", "fsx", "bashx", "npmx"]
}
