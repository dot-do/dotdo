{
  "name": "rpc.do",
  "version": "0.0.1",
  "description": "Cap'n Web RPC client/server for Durable Objects",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "rpc.do": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./transport/fetch": "./src/transport/fetch.ts",
    "./auth": "./src/auth/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "hono": "^4.7.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "tsup": "^8.5.1",
    "vitest": "^3.0.0"
  }
}
