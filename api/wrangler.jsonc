{
  "name": "dotdo-api",
  "main": "index.ts",
  "compatibility_date": "2025-01-15",

  // Durable Object bindings for API tests
  "durable_objects": {
    "bindings": [
      { "name": "DO", "class_name": "DO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" }
    ]
  },

  // Migrations for DO classes with SQL storage
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RateLimiterDO"]
    }
  ]
}
