{
  "name": "sdk.do",
  "version": "0.0.1",
  "description": "Unified SDK for dotdo - re-exports rpc.do and @dotdo/oauth",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./oauth": {
      "import": "./src/oauth.ts",
      "types": "./src/oauth.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "rpc.do": "workspace:*",
    "@dotdo/oauth": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
