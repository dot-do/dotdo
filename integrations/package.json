{
  "name": "@dotdo/integrations",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./stripe": {
      "import": "./dist/stripe/index.js",
      "types": "./dist/stripe/index.d.ts"
    },
    "./sendgrid": {
      "import": "./dist/sendgrid/index.js",
      "types": "./dist/sendgrid/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "description": "Third-party integration registry for dotdo",
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
