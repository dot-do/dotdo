{
  "name": "@dotdo/integrations",
  "version": "0.0.1",
  "description": "Third-party integration registry for dotdo (Stripe, SendGrid, etc.)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe/index.d.ts",
      "import": "./dist/stripe/index.js"
    },
    "./sendgrid": {
      "types": "./dist/sendgrid/index.d.ts",
      "import": "./dist/sendgrid/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "dotdo",
    "integrations",
    "stripe",
    "sendgrid",
    "cloudflare",
    "workers"
  ],
  "author": "dot-do",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dot-do/dotdo",
    "directory": "integrations"
  },
  "homepage": "https://dotdo.dev",
  "bugs": {
    "url": "https://github.com/dot-do/dotdo/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
