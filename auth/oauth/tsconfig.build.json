  "include": ["*.ts", "core/**/*.ts", "middleware/**/*.ts", "mcp/**/*.ts", "providers/**/*.ts", "storage/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "tests/**", "vitest.config.ts"]
}
