{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {},
    "types": ["@cloudflare/workers-types"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
