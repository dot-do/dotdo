{
  "name": "@dotdo/clickhouse",
  "version": "0.0.1",
  "description": "ClickHouse WASM analytics client for dotdo - wraps chdb with R2 storage",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./providers/*": {
      "types": "./src/providers/*.ts",
      "import": "./src/providers/*.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
