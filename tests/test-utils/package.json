{
  "name": "@dotdo/test-utils",
  "version": "0.0.1",
  "description": "Shared test utilities for @dotdo packages - DO stub helpers, factories, assertions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js"
    },
    "./factories": {
      "types": "./dist/factories.d.ts",
      "import": "./dist/factories.js"
    },
    "./assertions": {
      "types": "./dist/assertions.d.ts",
      "import": "./dist/assertions.js"
    },
    "./miniflare": {
      "types": "./dist/miniflare.d.ts",
      "import": "./dist/miniflare.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "dotdo",
    "testing",
    "vitest",
    "miniflare",
    "durable-objects"
  ],
  "author": "dot-do",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dot-do/dotdo",
    "directory": "test-utils"
  },
  "homepage": "https://dotdo.dev",
  "bugs": {
    "url": "https://github.com/dot-do/dotdo/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dotdo/utils": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^3.0.0",
    "miniflare": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "miniflare": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "miniflare": "^3.0.0"
  }
}
