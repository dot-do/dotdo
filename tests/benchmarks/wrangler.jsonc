{
  "name": "dotdo-benchmarks",
  "main": "bench-dos.ts",
  "compatibility_date": "2025-01-15",

  // Durable Object bindings for benchmarks
  "durable_objects": {
    "bindings": [
      { "name": "DO", "class_name": "BenchDO" }
    ]
  },

  // Migrations for DO classes with SQL storage
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BenchDO"]
    }
  ]
}
