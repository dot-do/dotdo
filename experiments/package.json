{
  "name": "@dotdo/experiments",
  "version": "0.0.1",
  "description": "A/B testing, feature flags, and experiments for dotdo",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./assignment": {
      "types": "./dist/assignment.d.ts",
      "import": "./dist/assignment.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "import": "./dist/flags.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ai-experiments": "file:../primitives/packages/ai-experiments"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
