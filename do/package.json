{
  "name": "@dotdo/do",
  "version": "0.1.0",
  "description": "THE Durable Object for Digital Objects - core DO class with SQLite storage",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./DO": {
      "types": "./dist/DO.d.ts",
      "import": "./dist/DO.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "import": "./dist/entities.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "import": "./dist/bindings.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    },
    "./circuit-breaker": {
      "types": "./dist/circuit-breaker.d.ts",
      "import": "./dist/circuit-breaker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "dotdo",
    "durable-objects",
    "digital-objects",
    "cloudflare",
    "workers",
    "sqlite",
    "edge"
  ],
  "author": "dot-do",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dot-do/dotdo",
    "directory": "do"
  },
  "homepage": "https://dotdo.dev",
  "bugs": {
    "url": "https://github.com/dot-do/dotdo/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dotdo/auth": "workspace:^",
    "@dotdo/business-finance": "workspace:^",
    "@dotdo/clickhouse": "workspace:^",
    "@dotdo/db": "workspace:^",
    "@dotdo/integrations": "workspace:^",
    "@dotdo/observability": "workspace:^",
    "@dotdo/rpc": "workspace:^",
    "@dotdo/utils": "workspace:^",
    "hono": "^4.11.4"
  },
  "devDependencies": {
    "@dotdo/test-utils": "workspace:*",
    "ai-evaluate": "^2.1.5",
    "digital-workers": "^2.1.3",
    "language-models": "^2.1.3",
    "typescript": "^5.7.3"
  }
}
