{
  "name": "dotdo-db",
  "main": "index.ts",
  "compatibility_date": "2025-01-15",

  // Durable Object bindings for database tests
  // Allows tests to use real SQLite storage via state.storage.sql
  "durable_objects": {
    "bindings": [
      { "name": "DO", "class_name": "DO" }
    ]
  },

  // Migrations for DO classes with SQL storage
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DO"]
    }
  ],

  // R2 bucket bindings for tiered storage integration tests
  // Miniflare provides in-memory R2 simulation for tests
  "r2_buckets": [
    {
      "binding": "R2_STORAGE",
      "bucket_name": "dotdo-storage"
    }
  ]
}
