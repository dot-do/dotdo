<?xml version="1.0"?>
<!--
  ClickHouse Users Configuration
  Optimized for containerized deployment
-->
<clickhouse>
    <profiles>
        <default>
            <!-- Memory limits per query -->
            <max_memory_usage>4000000000</max_memory_usage>
            <max_bytes_before_external_group_by>2000000000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>2000000000</max_bytes_before_external_sort>

            <!-- Thread settings -->
            <max_threads>4</max_threads>
            <max_insert_threads>4</max_insert_threads>

            <!-- S3 optimizations -->
            <s3_max_single_part_upload_size>67108864</s3_max_single_part_upload_size>
            <s3_min_upload_part_size>33554432</s3_min_upload_part_size>
            <s3_max_single_read_retries>4</s3_max_single_read_retries>
            <s3_check_objects_after_upload>false</s3_check_objects_after_upload>

            <!-- Enable filesystem cache by default -->
            <enable_filesystem_cache>1</enable_filesystem_cache>

            <!-- Result caching -->
            <use_query_cache>0</use_query_cache>

            <!-- Async insert for better throughput -->
            <async_insert>1</async_insert>
            <async_insert_busy_timeout_ms>200</async_insert_busy_timeout_ms>
            <wait_for_async_insert>1</wait_for_async_insert>

            <!-- Load balancing for distributed queries -->
            <load_balancing>random</load_balancing>
        </default>

        <readonly>
            <readonly>1</readonly>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_threads>2</max_threads>
        </readonly>
    </profiles>

    <users>
        <default>
            <!-- Empty password for local development -->
            <!-- Override with CLICKHOUSE_PASSWORD in production -->
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
