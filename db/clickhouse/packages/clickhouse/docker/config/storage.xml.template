<?xml version="1.0"?>
<!--
  ClickHouse S3 Storage Configuration
  Environment variables are substituted at container startup:
  - S3_ENDPOINT: S3/R2 endpoint URL (e.g., https://account-id.r2.cloudflarestorage.com)
  - S3_ACCESS_KEY: S3 access key ID
  - S3_SECRET_KEY: S3 secret access key
  - S3_BUCKET: Bucket name (default: clickhouse-data)
  - S3_REGION: S3 region (default: auto for R2)
  - CACHE_SIZE: Local cache size (default: 10G)
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <!-- S3/R2 remote storage -->
            <s3>
                <type>s3</type>
                <endpoint>${S3_ENDPOINT}/${S3_BUCKET}/</endpoint>
                <access_key_id>${S3_ACCESS_KEY}</access_key_id>
                <secret_access_key>${S3_SECRET_KEY}</secret_access_key>
                <region>${S3_REGION}</region>
                <!-- Metadata storage for S3 disk -->
                <metadata_path>/var/lib/clickhouse/disks/s3/</metadata_path>
                <!-- R2/S3 optimized settings -->
                <use_environment_credentials>false</use_environment_credentials>
                <request_timeout_ms>30000</request_timeout_ms>
                <connect_timeout_ms>10000</connect_timeout_ms>
                <max_connections>100</max_connections>
                <retry_attempts>10</retry_attempts>
                <!-- Skip access check on startup for faster boot -->
                <skip_access_check>false</skip_access_check>
                <!-- S3 performance settings -->
                <max_single_part_upload_size>33554432</max_single_part_upload_size>
                <min_upload_part_size>16777216</min_upload_part_size>
                <max_upload_part_size>536870912</max_upload_part_size>
                <upload_part_size_multiply_factor>2</upload_part_size_multiply_factor>
                <upload_part_size_multiply_parts_count_threshold>500</upload_part_size_multiply_parts_count_threshold>
            </s3>

            <!-- Local disk cache for S3 data -->
            <cache>
                <type>cache</type>
                <disk>s3</disk>
                <path>/var/lib/clickhouse/disks/cache/</path>
                <max_size>${CACHE_SIZE}</max_size>
                <!-- Cache settings optimized for containerized deployment -->
                <cache_on_write_operations>1</cache_on_write_operations>
                <enable_filesystem_cache_on_write_operations>1</enable_filesystem_cache_on_write_operations>
                <enable_filesystem_cache_log>0</enable_filesystem_cache_log>
                <do_not_evict_index_and_mark_files>1</do_not_evict_index_and_mark_files>
            </cache>

            <!-- Local disk for temporary data -->
            <default>
                <type>local</type>
                <path>/var/lib/clickhouse/</path>
            </default>
        </disks>

        <policies>
            <!-- Main storage policy: S3 with local cache -->
            <s3_main>
                <volumes>
                    <main>
                        <disk>cache</disk>
                    </main>
                </volumes>
            </s3_main>

            <!-- Default policy for system tables -->
            <default>
                <volumes>
                    <default>
                        <disk>default</disk>
                    </default>
                </volumes>
            </default>
        </policies>
    </storage_configuration>

    <!-- Set S3 as default storage policy for new tables -->
    <merge_tree>
        <storage_policy>s3_main</storage_policy>
    </merge_tree>
</clickhouse>
