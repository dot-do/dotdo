<?xml version="1.0"?>
<!--
  ClickHouse Server Settings
  Optimized for containerized deployment with S3 storage
-->
<clickhouse>
    <!-- Memory settings -->
    <max_server_memory_usage_to_ram_ratio>0.9</max_server_memory_usage_to_ram_ratio>

    <!-- Listen on all interfaces -->
    <listen_host>0.0.0.0</listen_host>

    <!-- HTTP interface settings -->
    <http_port>8123</http_port>
    <http_server_default_response><![CDATA[<html><body><h1>ClickHouse</h1><a href="/play">Play UI</a></body></html>]]></http_server_default_response>

    <!-- Native protocol -->
    <tcp_port>9000</tcp_port>

    <!-- Disable interserver for single-node deployment -->
    <interserver_http_port remove="remove"/>

    <!-- Logging -->
    <logger>
        <level>information</level>
        <console>true</console>
        <log remove="remove"/>
        <errorlog remove="remove"/>
    </logger>

    <!-- Query log to console only (no persistent storage required) -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <engine>Engine = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 3 DAY</engine>
    </query_log>

    <!-- Disable unnecessary features for container deployment -->
    <distributed_ddl>
        <path remove="remove"/>
    </distributed_ddl>

    <!-- Mark cache settings -->
    <mark_cache_size>5368709120</mark_cache_size>

    <!-- Uncompressed cache -->
    <uncompressed_cache_size>1073741824</uncompressed_cache_size>

    <!-- Background pool sizes -->
    <background_pool_size>8</background_pool_size>
    <background_schedule_pool_size>8</background_schedule_pool_size>
    <background_fetches_pool_size>4</background_fetches_pool_size>
    <background_move_pool_size>4</background_move_pool_size>
    <background_common_pool_size>4</background_common_pool_size>

    <!-- S3 specific optimizations -->
    <s3_max_redirects>10</s3_max_redirects>
    <s3_truncate_on_insert>true</s3_truncate_on_insert>

    <!-- Disable keeper/zookeeper - not needed for single-node S3 deployment -->
    <zookeeper incl="zookeeper" optional="true"/>
</clickhouse>
