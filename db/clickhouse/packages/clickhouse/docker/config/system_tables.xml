<?xml version="1.0"?>
<!--
  ClickHouse System Tables Storage Configuration
  Configures system tables to use S3 storage for stateless operation.
  This enables horizontal scaling without local state dependencies.
-->
<clickhouse>
    <!-- Configure system tables to use S3 storage policy -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <storage_policy>s3_main</storage_policy>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_log>

    <query_thread_log>
        <database>system</database>
        <table>query_thread_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
