<?xml version="1.0" encoding="UTF-8"?>
<!--
  R2 CORS Configuration for Browser WASM Access to Parquet Files

  This CORS configuration enables browser-based WASM applications to:
  - Make range requests for efficient partial file reads (critical for Parquet)
  - Access content-range and accept-ranges headers for partial response handling
  - Use etag for cache validation

  Usage with wrangler CLI:
    wrangler r2 bucket cors put <BUCKET_NAME> --rules r2-cors.xml

  Or apply programmatically:
    import { configureR2Cors, defaultWasmCorsConfig } from '@dotdo/clickhouse/r2';

    await configureR2Cors(
      process.env.CF_ACCOUNT_ID!,
      process.env.R2_ACCESS_KEY_ID!,
      process.env.R2_SECRET_ACCESS_KEY!,
      'my-bucket',
      defaultWasmCorsConfig
    );

  For production, replace the wildcard origin with your specific domains:
    <AllowedOrigin>https://app.example.com</AllowedOrigin>
    <AllowedOrigin>https://www.example.com</AllowedOrigin>
-->
<CORSConfiguration>
  <CORSRule>
    <!-- Allow all origins (restrict to specific domains in production) -->
    <AllowedOrigin>*</AllowedOrigin>

    <!-- HTTP methods needed for Parquet file access -->
    <AllowedMethod>GET</AllowedMethod>
    <AllowedMethod>HEAD</AllowedMethod>

    <!-- Request headers that browsers may send -->
    <AllowedHeader>range</AllowedHeader>
    <AllowedHeader>content-type</AllowedHeader>

    <!-- Response headers exposed to browser JavaScript -->
    <ExposeHeader>content-length</ExposeHeader>
    <ExposeHeader>content-range</ExposeHeader>
    <ExposeHeader>accept-ranges</ExposeHeader>
    <ExposeHeader>etag</ExposeHeader>

    <!-- Cache preflight responses for 24 hours -->
    <MaxAgeSeconds>86400</MaxAgeSeconds>
  </CORSRule>
</CORSConfiguration>
