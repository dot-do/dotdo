--- a/cmake/target.cmake
+++ b/cmake/target.cmake
@@ -1,3 +1,6 @@
+# Target system detection with WASM/Emscripten support
+# Patched for chdb-wasm builds
+
 if (CMAKE_SYSTEM_NAME MATCHES "Linux")
     set (OS_LINUX 1)
     add_definitions(-D OS_LINUX)
@@ -16,6 +19,17 @@ elseif (CMAKE_SYSTEM_NAME MATCHES "Darwin")
 elseif (CMAKE_SYSTEM_NAME MATCHES "SunOS")
     set (OS_SUNOS 1)
     add_definitions(-D OS_SUNOS)
+elseif (CMAKE_SYSTEM_NAME MATCHES "Emscripten" OR EMSCRIPTEN)
+    # WebAssembly via Emscripten
+    set (OS_EMSCRIPTEN 1)
+    set (OS_WASM 1)
+    add_definitions(-D OS_EMSCRIPTEN)
+    add_definitions(-D OS_WASM)
+
+    # Emscripten provides a POSIX-like environment
+    # but with significant differences
+    add_definitions(-D __EMSCRIPTEN__)
+
+    message (STATUS "Building for Emscripten/WebAssembly target")
 else ()
     message (FATAL_ERROR "Platform ${CMAKE_SYSTEM_NAME} is not supported")
 endif ()
@@ -72,6 +86,56 @@ if (CMAKE_CROSSCOMPILING)
     elseif (OS_FREEBSD)
         # FIXME: broken dependencies
         set (ENABLE_EMBEDDED_COMPILER OFF CACHE INTERNAL "")
         set (ENABLE_DWARF_PARSER OFF CACHE INTERNAL "")
+    elseif (OS_EMSCRIPTEN OR OS_WASM)
+        # WebAssembly/Emscripten cross-compilation settings
+        # Disable features that are not supported or don't make sense in WASM
+
+        # No glibc in Emscripten
+        set (GLIBC_COMPATIBILITY OFF CACHE INTERNAL "")
+
+        # Disable network-related features (no sockets in WASM by default)
+        set (ENABLE_GRPC OFF CACHE INTERNAL "")
+        set (ENABLE_ARROW_FLIGHT OFF CACHE INTERNAL "")
+        set (ENABLE_HDFS OFF CACHE INTERNAL "")
+        set (ENABLE_MYSQL OFF CACHE INTERNAL "")
+        set (ENABLE_LIBPQXX OFF CACHE INTERNAL "")
+        set (ENABLE_LDAP OFF CACHE INTERNAL "")
+        set (ENABLE_ODBC OFF CACHE INTERNAL "")
+        set (ENABLE_KAFKA OFF CACHE INTERNAL "")
+        set (ENABLE_NATS OFF CACHE INTERNAL "")
+        set (ENABLE_AMQPCPP OFF CACHE INTERNAL "")
+        set (ENABLE_CASSANDRA OFF CACHE INTERNAL "")
+        set (ENABLE_MONGODB OFF CACHE INTERNAL "")
+        set (ENABLE_REDIS OFF CACHE INTERNAL "")
+
+        # No native code generation in WASM
+        set (ENABLE_EMBEDDED_COMPILER OFF CACHE INTERNAL "")
+        set (ENABLE_DWARF_PARSER OFF CACHE INTERNAL "")
+
+        # No Rust support in WASM build
+        set (ENABLE_RUST OFF CACHE INTERNAL "")
+
+        # Memory allocator - use Emscripten's allocator
+        set (ENABLE_JEMALLOC OFF CACHE INTERNAL "")
+        set (ENABLE_MIMALLOC OFF CACHE INTERNAL "")
+
+        # Disable assembly optimizations - use pure C/C++
+        set (OPENSSL_NO_ASM ON CACHE INTERNAL "")
+        set (ENABLE_FASTOPS OFF CACHE INTERNAL "")
+
+        # Disable Parquet (complex native dependencies)
+        set (ENABLE_PARQUET OFF CACHE INTERNAL "")
+        set (ENABLE_ORC OFF CACHE INTERNAL "")
+        set (ENABLE_ARROW OFF CACHE INTERNAL "")
+
+        # Disable ICU (large dependency, may need special handling)
+        set (ENABLE_ICU OFF CACHE INTERNAL "")
+
+        # Disable protobuf (complex build)
+        set (ENABLE_PROTOBUF OFF CACHE INTERNAL "")
+
+        # Disable BLAKE3 (assembly optimizations)
+        set (ENABLE_BLAKE3 OFF CACHE INTERNAL "")
+
+        # Disable S3 (network)
+        set (ENABLE_S3 OFF CACHE INTERNAL "")
+
+        # Disable Azure (network)
+        set (ENABLE_AZURE_BLOB_STORAGE OFF CACHE INTERNAL "")
+
+        message (STATUS "Cross-compiling for Emscripten/WebAssembly - many features disabled")
     else ()
         message (FATAL_ERROR "Trying to cross-compile to unsupported system: ${CMAKE_SYSTEM_NAME}!")
     endif ()
