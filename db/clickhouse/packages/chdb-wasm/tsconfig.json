{
  // TypeScript Configuration for chdb-wasm
  // ======================================
  // This configuration enforces strict type checking for Cloudflare Workers.
  //
  // Strict Mode Options:
  // - strict: true           - Enables all strict type checking options
  // - noImplicitAny          - Error on expressions with implied 'any' type
  // - strictNullChecks       - Null/undefined are distinct types
  // - noUnusedLocals         - Error on unused local variables
  // - noUnusedParameters     - Error on unused function parameters
  // - noImplicitReturns      - Error when not all code paths return a value
  // - noFallthroughCasesInSwitch - Error on fallthrough cases in switch
  // - noImplicitOverride     - Require 'override' keyword for class method overrides
  //
  // Not Currently Enabled (would require significant refactoring):
  // - noUncheckedIndexedAccess - Adds 'undefined' to index access types (500+ errors)
  // - exactOptionalPropertyTypes - Stricter optional property handling (12 errors)
  // - noPropertyAccessFromIndexSignature - Requires bracket notation (42 errors)
  //
  // Run type checking: pnpm run typecheck
  // CI enforces type checking on every PR (see .github/workflows/test.yml)
  //
  "compilerOptions": {
    // Language and Module Settings
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],

    // Output Settings
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Strict Type Checking (all enabled)
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    // Module Interop
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // Path Mapping for WASM types
    "paths": {
      "../build-wasm/dist/chdb.js": ["./src/chdb-wasm.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "build-*", "wasm", "tests", "benchmarks"]
}
