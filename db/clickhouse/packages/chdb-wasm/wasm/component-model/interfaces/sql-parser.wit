// WASM Component Model Interface for SQL Parser
//
// This WIT (WebAssembly Interface Types) file defines the interface
// for a SQL parsing component. This is a DESIGN PROTOTYPE - not yet
// usable in production due to lack of browser/Workers support.
//
// WIT Reference: https://component-model.bytecodealliance.org/design/wit.html

package chdb:sql@0.1.0

/// SQL parsing interface
///
/// Provides tokenization and parsing of SQL queries compatible
/// with ClickHouse SQL dialect.
interface sql-parser {

  // =============================================================
  // Token Types
  // =============================================================

  /// Token type enumeration matching ClickHouse lexer tokens
  enum token-type {
    // Literals
    whitespace,
    comment,
    bare-word,
    number,
    string-literal,
    quoted-identifier,
    here-doc,

    // Brackets
    opening-round-bracket,
    closing-round-bracket,
    opening-square-bracket,
    closing-square-bracket,
    opening-curly-brace,
    closing-curly-brace,

    // Operators
    comma,
    semicolon,
    dot,
    asterisk,
    plus,
    minus,
    slash,
    percent,
    arrow,
    colon,
    double-colon,
    equals,
    not-equals,
    less,
    greater,
    less-or-equals,
    greater-or-equals,
    spaceship,
    pipe-mark,
    concatenation,
    caret,
    question-mark,
    at,
    double-at,
    dollar-sign,
    vertical-delimiter,

    // Control
    end-of-stream,

    // Errors
    error-generic,
    error-multiline-comment-not-closed,
    error-single-quote-not-closed,
    error-double-quote-not-closed,
    error-back-quote-not-closed,
    error-single-exclamation-mark,
    error-single-pipe-mark,
    error-wrong-number,
    error-max-query-size-exceeded,
  }

  /// A single token from the lexer
  record token {
    /// The type of token
    token-type: token-type,
    /// Start position (byte offset) in the source
    begin: u32,
    /// End position (byte offset) in the source
    end: u32,
  }

  // =============================================================
  // Lexer Functions
  // =============================================================

  /// Tokenize a SQL string into a list of tokens
  ///
  /// Returns all tokens including whitespace and comments.
  /// Use `tokenize-significant` to get only meaningful tokens.
  tokenize: func(sql: string) -> list<token>

  /// Tokenize a SQL string, returning only significant tokens
  ///
  /// Filters out whitespace and comment tokens.
  tokenize-significant: func(sql: string) -> list<token>

  /// Get the string name of a token type
  token-type-name: func(t: token-type) -> string

  // =============================================================
  // AST Types
  // =============================================================

  /// AST node type enumeration
  enum ast-type {
    // Queries
    select-query,
    insert-query,
    create-query,
    drop-query,
    alter-query,

    // Expressions
    identifier,
    literal,
    function-call,
    binary-op,
    unary-op,
    subquery,

    // Clauses
    select-clause,
    from-clause,
    where-clause,
    group-by-clause,
    having-clause,
    order-by-clause,
    limit-clause,

    // Other
    table-name,
    column-name,
    alias,
    asterisk,

    // Error
    parse-error,
  }

  /// Parse error information
  record parse-error {
    /// Human-readable error message
    message: string,
    /// Line number (1-indexed) where error occurred
    line: u32,
    /// Column number (1-indexed) where error occurred
    column: u32,
    /// Byte offset in the source
    position: u32,
  }

  /// Simplified AST node (for prototyping)
  ///
  /// Note: A full implementation would use a recursive variant type,
  /// but WIT's type system makes this complex. This simplified version
  /// uses a flat representation with child indices.
  record ast-node {
    /// Node type
    node-type: ast-type,
    /// Start position in source
    begin: u32,
    /// End position in source
    end: u32,
    /// Index of first child in node list, or -1 if none
    first-child: s32,
    /// Number of children
    child-count: u32,
    /// String value for literals/identifiers (empty otherwise)
    value: string,
  }

  /// Parse result containing AST or error
  record parse-result {
    /// True if parsing succeeded
    success: bool,
    /// Root AST nodes (may be multiple for multi-statement queries)
    nodes: list<ast-node>,
    /// Parse errors (empty if success is true)
    errors: list<parse-error>,
  }

  // =============================================================
  // Parser Functions
  // =============================================================

  /// Parse a SQL query into an AST
  parse: func(sql: string) -> parse-result

  /// Parse a SQL expression (not a full query)
  parse-expression: func(sql: string) -> parse-result

  /// Validate SQL syntax without building full AST
  ///
  /// Faster than full parse when you only need to check validity.
  validate: func(sql: string) -> list<parse-error>

  // =============================================================
  // Utility Functions
  // =============================================================

  /// Format/pretty-print a SQL query
  format: func(sql: string) -> result<string, parse-error>

  /// Extract table names referenced in a query
  extract-tables: func(sql: string) -> result<list<string>, parse-error>

  /// Extract column names referenced in a query
  extract-columns: func(sql: string) -> result<list<string>, parse-error>
}

/// SQL execution interface
///
/// Executes SQL queries against in-memory data.
interface sql-executor {
  use sql-parser.{parse-error}

  // =============================================================
  // Data Types
  // =============================================================

  /// Column data type
  enum column-type {
    uint8,
    uint16,
    uint32,
    uint64,
    int8,
    int16,
    int32,
    int64,
    float32,
    float64,
    string,
    date,
    datetime,
    boolean,
    nullable-uint8,
    nullable-uint16,
    nullable-uint32,
    nullable-uint64,
    nullable-int8,
    nullable-int16,
    nullable-int32,
    nullable-int64,
    nullable-float32,
    nullable-float64,
    nullable-string,
  }

  /// Column metadata
  record column-info {
    name: string,
    data-type: column-type,
  }

  /// Query result
  record query-result {
    /// Column definitions
    columns: list<column-info>,
    /// Row count
    row-count: u64,
    /// Serialized data (JSON or other format)
    data: list<u8>,
    /// Data format identifier
    format: string,
  }

  /// Execution error
  record execution-error {
    /// Error code
    code: u32,
    /// Error message
    message: string,
  }

  // =============================================================
  // Executor Functions
  // =============================================================

  /// Execute a SQL query and return results
  execute: func(sql: string) -> result<query-result, execution-error>

  /// Execute a query with parameters
  execute-parameterized: func(
    sql: string,
    params: list<tuple<string, string>>
  ) -> result<query-result, execution-error>

  /// Register a table from in-memory data
  register-table: func(
    name: string,
    columns: list<column-info>,
    data: list<u8>,
    format: string,
  ) -> result<_, execution-error>

  /// Unregister a table
  unregister-table: func(name: string) -> result<_, execution-error>

  /// List registered tables
  list-tables: func() -> list<string>

  /// Describe a table's schema
  describe-table: func(name: string) -> result<list<column-info>, execution-error>
}

/// World definition for a complete SQL component
///
/// A "world" in WIT defines the complete interface a component
/// exports and imports.
world sql-component {
  /// Export the parser interface
  export sql-parser

  /// Export the executor interface
  export sql-executor
}

/// Minimal world for just the parser
world sql-parser-component {
  export sql-parser
}

/// Minimal world for just the lexer (subset of parser)
world sql-lexer-component {
  export sql-parser.{
    token-type,
    token,
    tokenize,
    tokenize-significant,
    token-type-name,
  }
}
