{
  "name": "@chdb-wasm/tests",
  "version": "0.1.0",
  "private": true,
  "description": "Test suite for chdb WASM module",
  "type": "module",
  "scripts": {
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest watch --config tests/vitest.config.ts",
    "test:ui": "vitest --ui --config tests/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config tests/vitest.config.ts",
    "test:queries": "vitest run tests/test-queries.ts --config tests/vitest.config.ts",
    "test:formats": "vitest run tests/test-formats.ts --config tests/vitest.config.ts",
    "test:memory": "vitest run tests/test-memory.ts --config tests/vitest.config.ts",
    "test:verbose": "vitest run --reporter=verbose --config tests/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
