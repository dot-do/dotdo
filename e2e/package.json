{
  "name": "@dotdo/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end tests for dotdo - SDK and browser testing against live workers",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:browser:ui": "playwright test --ui"
  },
  "keywords": [
    "dotdo",
    "e2e",
    "testing",
    "playwright",
    "vitest"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@dotdo/api": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
