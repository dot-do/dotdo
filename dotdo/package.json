{
  "name": "dotdo",
  "version": "0.0.1",
  "description": "Digital Objects runtime framework for Cloudflare Durable Objects",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dotdo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./do": {
      "types": "./dist/do.d.ts",
      "import": "./dist/do.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./sdk/client": {
      "types": "./dist/sdk/client.d.ts",
      "import": "./dist/sdk/client.js"
    },
    "./sdk/testing": {
      "types": "./dist/sdk/testing.d.ts",
      "import": "./dist/sdk/testing.js"
    },
    "./sdk/deploy": {
      "types": "./dist/sdk/deploy.d.ts",
      "import": "./dist/sdk/deploy.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cloudflare",
    "durable-objects",
    "digital-objects",
    "workers",
    "edge",
    "ai",
    "typescript"
  ],
  "author": "dot-do",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dot-do/dotdo"
  },
  "homepage": "https://dotdo.dev",
  "bugs": {
    "url": "https://github.com/dot-do/dotdo/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dotdo/ai": "workspace:*",
    "@dotdo/api": "workspace:*",
    "@dotdo/auth": "workspace:*",
    "@dotdo/db": "workspace:*",
    "@dotdo/do": "workspace:*",
    "@dotdo/mcp": "workspace:*",
    "@dotdo/rpc": "workspace:*",
    "rpc.do": "workspace:*",
    "commander": "^13.0.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
